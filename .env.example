# FAULTLINE Environment Configuration Example

# AWS Configuration
AWS_REGION=us-east-1
# Bedrock Foundation Model or Inference Profile
# Supported: amazon.nova-lite-v1:0, amazon.nova-pro-v1:0, anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Application Configuration
PORT=8000
ENVIRONMENT=development
MAX_TOOL_ROUNDS=8
ALLOW_CUSTOM_CSV=false
CORS_ORIGIN=*

# Optional AWS Deployment Outputs (injected during deployment)
API_GATEWAY_URL=
S3_FRONTEND_BUCKET=
